# =============================================================================
# figma-mcp — environment variables
# =============================================================================
# In embedded mode, .env is *optional*. All env vars below have sensible
# defaults. Most of these can also be set inline in .vscode/mcp.json.
#
# Usage (optional):
#   cp .env.example .env

# Playwright session storage. Default: <package>/.playwright-state/figma.json
# FIGMA_STATE_PATH=.playwright-state/figma.json

# Override: full path to a persistent Chrome profile dir (preserves Google OAuth
# cookies more faithfully than storageState JSON). login-figma.ts creates this.
# FIGMA_PROFILE_DIR=.playwright-state/chrome-profile

# OPTIONAL: only needed by figma_get_node_info (JSON metadata). The flagship
# figma_get_screenshot tool does NOT use REST — it renders via Playwright.
# Get one at: https://www.figma.com/settings → Personal Access Tokens
# FIGMA_TOKEN=figd_replace-with-your-pat

# Log verbosity (debug | info | warn | error)
# LOG_LEVEL=info
