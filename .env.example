# =============================================================================
# figma-mcp-poc — .env (Phase 0/1 で作成)
# =============================================================================
# Usage:
#   cp .env.example .env
#   # 各値を埋める。.env はコミット禁止 (.gitignore 済み)
#
# 詳細は docs/reference/env-vars.md を参照。

# -----------------------------------------------------------------------------
# Supabase (Phase 1 以降)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key

# Phase 1 で作成した個人 PoC ユーザー
POC_EMAIL=you@example.com
POC_PASSWORD=replace-with-your-password

# Storage / 署名 URL
STORAGE_BUCKET=figma-assets
SIGNED_URL_TTL_SEC=300

# -----------------------------------------------------------------------------
# Figma (Phase 3 以降)
# -----------------------------------------------------------------------------
# Personal Access Token: https://www.figma.com/settings → Personal Access Tokens
FIGMA_TOKEN=figd_replace-with-your-pat

# Playwright storageState (Phase 6/7 デプロイ時のみ。base64 化 JSON)
# ローカル開発時は .playwright-state/figma.json を直接使うため不要
# FIGMA_STATE_JSON=

# -----------------------------------------------------------------------------
# サービス間通信 (Phase 4 以降)
# -----------------------------------------------------------------------------
WORKER_URL=http://localhost:3000
PORT=3000

# -----------------------------------------------------------------------------
# ロギング
# -----------------------------------------------------------------------------
MCP_LOG_FILE=/tmp/figma-mcp-poc.log
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Phase 7 (リモート MCP) — dev 機にはこれ 1 つだけあれば動く
# -----------------------------------------------------------------------------
# FIGMA_MCP_TOKEN=fmps_replace-with-issued-api-key
