{
  "name": "figma-mcp-poc",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter figma-mcp-service dev",
    "login-figma": "pnpm --filter figma-mcp-service exec tsx scripts/login-figma.ts",
    "get-token": "tsx scripts/get-token.ts",
    "issue-api-key": "tsx scripts/issue-api-key.ts",
    "test": "pnpm -r test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@types/node": "^20.11.0",
    "prettier": "^3.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
